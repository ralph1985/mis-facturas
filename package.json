{
  "name": "mis-facturas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "auth:hash": "tsx scripts/hash-access-code.ts",
    "import:legacy": "tsx scripts/import-legacy-sqlite.ts",
    "verify:import": "tsx scripts/verify-electricity-import.ts",
    "backup:db": "scripts/backup-postgres.sh",
    "backup:db:verify": "scripts/verify-postgres-backup.sh"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.1",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "deepmerge-ts": "8.0.0",
      "mysql2": "3.23.1"
    }
  }
}
