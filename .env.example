# Mis Facturas local configuration. Fill these only in .env.local or the
# process environment; never commit real values.
DATABASE_URL=
MIS_FACTURAS_ACCESS_CODE_HASH=
MIS_FACTURAS_SESSION_SECRET=
# Optional: 300 seconds to 30 days; default is 12 hours.
MIS_FACTURAS_SESSION_MAX_AGE_SECONDS=
# Optional legacy source path for local, read-only import tooling.
LEGACY_SQLITE_PATH=
# Optional PostgreSQL backup paths, retention, and explicit binaries.
MIS_FACTURAS_BACKUP_DIR=
MIS_FACTURAS_LOG_DIR=
MIS_FACTURAS_BACKUP_RETENTION_DAYS=
PG_DUMP_BIN=
NODE_BIN=
# Optional cron schedule and lock path; defaults to 01:30 Europe/Madrid.
MIS_FACTURAS_BACKUP_CRON_SCHEDULE=
MIS_FACTURAS_BACKUP_LOCK_FILE=
CRONTAB_BIN=
NODE_ENV=development
