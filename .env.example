# Mis Facturas local configuration. Fill these only in .env.local or the
# process environment; never commit real values.
DATABASE_URL=
MIS_FACTURAS_ACCESS_CODE_HASH=
MIS_FACTURAS_SESSION_SECRET=
# Optional: 300 seconds to 30 days; default is 12 hours.
MIS_FACTURAS_SESSION_MAX_AGE_SECONDS=
# Optional legacy source path for local, read-only import tooling.
LEGACY_SQLITE_PATH=
NODE_ENV=development
